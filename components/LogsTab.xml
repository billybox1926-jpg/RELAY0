<?xml version="1.0" encoding="utf-8" ?>
<component name="LogsTab" extends="Group">
    <interface>
        <function name="setParentScene" />
        <function name="refresh" />
        <function name="handleKey" />
        <function name="onEvent" />
    </interface>
    <children>
        <!-- Section Title -->
        <Label id="title" text="[ SYSTEM LOGS ]"
               translation="[60, 20]" font="font:MediumBoldSystemFont" color="0x00FF41FF" />
        <Rectangle translation="[60, 44]" width="1160" height="1" color="0x00FF4140" />

        <!-- Log Count -->
        <Label id="logCount" text="Entries: 0"
               translation="[1060, 20]" font="font:SmallSystemFont" color="#88CC88FF" />

        <!-- Log Display Area -->
        <Label id="logDisplay" text="No logs yet."
               translation="[60, 58]" font="font:SmallSystemFont" color="#CCFFCCFF"
               wrap="true" width="1160" height="530" />

        <!-- Bottom Actions -->
        <Rectangle translation="[60, 600]" width="1160" height="1" color="0x00FF4120" />
        <Label id="clearInfo" text="OK: Clear All Logs"
               translation="[60, 615]" font="font:SmallSystemFont" color="#88AA88FF" />
    </children>
    <script type="text/brightscript" uri="pkg:/components/LogsTab.brs" />
</component>
