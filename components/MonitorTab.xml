<?xml version="1.0" encoding="utf-8" ?>
<component name="MonitorTab" extends="Group">
    <interface>
        <function name="setParentScene" />
        <function name="updateUI" />
        <function name="handleKey" />
        <function name="onEvent" />
    </interface>
    <children>
        <!-- Section Title -->
        <Label id="title" text="[ SYSTEM MONITOR ]"
               translation="[60, 20]" font="font:MediumBoldSystemFont" color="0x00FF41FF" />
        <Rectangle translation="[60, 44]" width="1160" height="1" color="0x00FF4140" />

        <!-- Power Bar -->
        <Label id="powerLabel" text="POWER"
               translation="[80, 65]" font="font:MediumSystemFont" color="0xCCFFCCFF" />
        <Rectangle id="powerBarBg" translation="[220, 68]" width="500" height="22" color="#1A2E1A" />
        <Rectangle id="powerBarFill" translation="[220, 68]" width="400" height="22" color="#00CC33" />
        <Label id="powerValue" text="80/100"
               translation="[730, 65]" font="font:MediumSystemFont" color="#00CC33FF" />

        <!-- Heat Bar -->
        <Label id="heatLabel" text="HEAT"
               translation="[80, 110]" font="font:MediumSystemFont" color="0xCCFFCCFF" />
        <Rectangle id="heatBarBg" translation="[220, 113]" width="500" height="22" color="#2E1A1A" />
        <Rectangle id="heatBarFill" translation="[220, 113]" width="200" height="22" color="#FF6644" />
        <Label id="heatValue" text="25/100"
               translation="[730, 110]" font="font:MediumSystemFont" color="#FF6644FF" />

        <!-- Throughput Bar -->
        <Label id="throughputLabel" text="THROUGHPUT"
               translation="[80, 155]" font="font:MediumSystemFont" color="0xCCFFCCFF" />
        <Rectangle id="throughputBarBg" translation="[280, 158]" width="440" height="22" color="#1A1A2E" />
        <Rectangle id="throughputBarFill" translation="[280, 158]" width="180" height="22" color="#4488FF" />
        <Label id="throughputValue" text="40/100"
               translation="[730, 155]" font="font:MediumSystemFont" color="#4488FFFF" />

        <!-- Network Health Bar -->
        <Label id="healthLabel" text="NET HEALTH"
               translation="[80, 200]" font="font:MediumSystemFont" color="0xCCFFCCFF" />
        <Rectangle id="healthBarBg" translation="[260, 203]" width="460" height="22" color="#1A2E1A" />
        <Rectangle id="healthBarFill" translation="[260, 203]" width="460" height="22" color="#00FF88" />
        <Label id="healthValue" text="100%"
               translation="[730, 200]" font="font:MediumSystemFont" color="#00FF88FF" />

        <!-- Separator -->
        <Rectangle translation="[60, 245]" width="1160" height="1" color="0x00FF4120" />

        <!-- Credits Display -->
        <Label id="creditsTitle" text="CREDITS"
               translation="[80, 265]" font="font:MediumSystemFont" color="0xCCFFCCFF" />
        <Label id="creditsLabel" text="100"
               translation="[260, 265]" font="font:LargeBoldSystemFont" color="#00FF41FF" />

        <!-- Income Rate -->
        <Label id="incomeLabel" text="Income: ~10/min"
               translation="[400, 268]" font="font:SmallSystemFont" color="#88AA88FF" />

        <!-- Upgrade Level -->
        <Label id="upgradeLabel" text="Upgrade Level: 0"
               translation="[80, 310]" font="font:MediumSystemFont" color="#AAAAAAFF" />

        <!-- Nodes Count -->
        <Label id="nodesLabel" text="Active Nodes: 1 / 3"
               translation="[80, 345]" font="font:MediumSystemFont" color="#AAAAAAFF" />

        <!-- Separator -->
        <Rectangle translation="[60, 385]" width="1160" height="1" color="0x00FF4120" />

        <!-- Warnings Area -->
        <Label id="warningTitle" text="[ ALERTS ]"
               translation="[80, 405]" font="font:MediumSystemFont" color="#FFAA44FF" />
        <Label id="warningText" text="All systems nominal."
               translation="[80, 435]" font="font:SmallSystemFont" color="#88FF88FF"
               wrap="true" width="1100" height="200" />

        <!-- Stats Panel (right side) -->
        <Rectangle id="statsBg" translation="[820, 260]" width="400" height="120" color="#0D150D" />
        <Label id="statsTitle" text="[ STATISTICS ]"
               translation="[840, 270]" font="font:MediumSystemFont" color="#00FF41FF" />
        <Label id="statsText" text="Rules: 0 | Logs: 0"
               translation="[840, 305]" font="font:SmallSystemFont" color="#88CC88FF"
               wrap="true" width="360" height="60" />
    </children>
    <script type="text/brightscript" uri="pkg:/components/MonitorTab.brs" />
</component>
